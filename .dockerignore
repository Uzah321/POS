# Composer/package auto-discovery cache — regenerated at container start
# (docker-entrypoint.sh runs package:discover) once the real, --no-dev
# vendor/ is in place. A stale host-generated copy (e.g. referencing a
# require-dev-only provider like laravel/pail) would crash the app on boot.
